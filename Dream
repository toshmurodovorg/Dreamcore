<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cheksiz maysazor</title>
<link href="https://fonts.googleapis.com/css2?family=Marcellus&family=VT323&display=swap" rel="stylesheet">
<style>
:root{--ink:#fffafc;--ink2:#f6e6ee;--glass:rgba(255,235,245,.16);--edge:rgba(255,255,255,.38);--serif:'Marcellus',Georgia,serif;--vhs:'VT323',monospace}
*{box-sizing:border-box;margin:0}
html,body{background:#6fb3e6}
body{height:100vh;overflow:hidden;font-family:var(--serif);color:var(--ink)}
#gl{position:fixed;inset:0;z-index:0}#gl canvas{display:block;filter:contrast(1.06) saturate(1.1) brightness(1.02)}
.fx{position:fixed;inset:0;pointer-events:none;z-index:5}
.vig{background:radial-gradient(ellipse at center,rgba(0,0,0,0) 58%,rgba(8,18,12,.5) 100%)}
.scan{background:repeating-linear-gradient(0deg,rgba(0,0,0,.07) 0 1px,rgba(0,0,0,0) 1px 3px)}
.glare{background:radial-gradient(circle at 16% 4%,rgba(255,244,214,.5) 0%,rgba(255,236,190,.2) 14%,rgba(255,236,190,0) 38%),conic-gradient(from 200deg at 16% 4%,rgba(255,240,200,0) 0deg,rgba(255,240,200,.1) 12deg,rgba(255,240,200,0) 26deg,rgba(255,240,200,.08) 40deg,rgba(255,240,200,0) 58deg);mix-blend-mode:screen}
#grain{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:6;mix-blend-mode:overlay;opacity:.3;image-rendering:pixelated}
.rec{position:fixed;left:0;top:0;z-index:7;padding:calc(14px + env(safe-area-inset-top,0px)) 18px 0;font:26px var(--vhs);color:#fff;text-shadow:2px 0 rgba(255,0,60,.55),-2px 0 rgba(0,220,255,.55)}
.msg{position:fixed;inset:0;display:none;place-items:center;text-align:center;padding:30px;z-index:9;background:#16322b;font-size:1.3rem}
.cards{position:fixed;inset:0;z-index:4;pointer-events:none}
.card{position:absolute;left:50%;bottom:calc(6vh + env(safe-area-inset-bottom,0px));width:min(560px,90vw);margin-left:calc(min(560px,90vw) / -2);padding:clamp(22px,4vw,38px);opacity:0;
  background:var(--glass);border:1px solid var(--edge);border-radius:26px;-webkit-backdrop-filter:blur(16px) saturate(140%);backdrop-filter:blur(16px) saturate(140%);
  box-shadow:0 24px 50px -18px rgba(40,10,40,.5),inset 0 1px 0 rgba(255,255,255,.45)}
h1,h2{font-weight:400;line-height:1.05;text-shadow:-1px 0 rgba(255,0,80,.4),1px 0 rgba(0,200,255,.4)}
h1{font-size:clamp(2.4rem,7vw,4rem)}h2{font-size:clamp(1.9rem,5vw,2.8rem)}
.card p{margin-top:12px;color:var(--ink2);font-size:1.12rem;line-height:1.6}
.btn{pointer-events:auto;display:inline-block;margin-top:18px;padding:12px 24px;border-radius:999px;border:1px solid var(--edge);background:rgba(255,255,255,.24);color:var(--ink);font:1rem var(--serif);cursor:pointer}
.btn:hover{background:rgba(255,255,255,.4)}.btn:focus-visible{outline:3px solid #ffd24d;outline-offset:3px}

.hud{position:fixed;top:calc(12px + env(safe-area-inset-top,0px));left:0;right:0;text-align:center;z-index:7;font:28px var(--vhs);color:#fff;text-shadow:2px 0 rgba(255,0,60,.5),-2px 0 rgba(0,220,255,.5);pointer-events:none;display:none;line-height:1.1}
.toast{position:fixed;left:50%;bottom:16vh;transform:translateX(-50%);z-index:8;padding:12px 22px;border-radius:999px;background:var(--glass);border:1px solid var(--edge);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);opacity:0;transition:opacity .4s;pointer-events:none;white-space:nowrap;max-width:92vw}
.dusk{background:#ff7ab0;mix-blend-mode:soft-light;opacity:0;z-index:4;transition:opacity 1.5s}
.screen{position:fixed;inset:0;z-index:10;display:grid;place-items:center;padding:20px;background:rgba(20,40,35,.3);-webkit-backdrop-filter:blur(5px);backdrop-filter:blur(5px)}
.panel{max-width:540px;padding:clamp(24px,4vw,40px);text-align:center;background:var(--glass);border:1px solid var(--edge);border-radius:26px;-webkit-backdrop-filter:blur(18px) saturate(140%);backdrop-filter:blur(18px) saturate(140%);box-shadow:0 24px 50px -18px rgba(40,10,40,.5),inset 0 1px 0 rgba(255,255,255,.45)}
.panel p{margin-top:12px;color:var(--ink2);font-size:1.12rem;line-height:1.6}
.panel small{display:block;margin-top:16px;color:var(--ink2);font-size:.95rem;line-height:1.5}
.fwd{position:fixed;right:22px;bottom:calc(26px + env(safe-area-inset-bottom,0px));width:76px;height:76px;border-radius:50%;z-index:9;border:1px solid var(--edge);background:var(--glass);color:#fff;font-size:1.6rem;display:none;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);touch-action:none}
@media (pointer:coarse){.fwd{display:block}}
</style>
</head>
<body>
<div id="gl"></div>
<div class="fx vig"></div><div class="fx glare" id="glare"></div><div class="fx scan"></div><canvas id="grain" width="200" height="120"></canvas>
